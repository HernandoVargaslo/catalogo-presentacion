        },
        {
          "title": "fecha y Hora",
          "const": "fecha y Hora"
        },
        {
          "title": "hora",
          "const": "hora"
        },
        {
          "title": "imagen",
          "const": "imagen"
        },
        {
          "title": "lógico",
          "const": "lógico"
        },
        {
          "title": "Número",
          "const": "Número"
        },
        {
          "title": "probabilidad",
          "const": "probabilidad"
        },
        {
          "title": "real",
          "const": "real"
        },
        {
          "title": "secuencia",
          "const": "secuencia"
        },
        {
          "title": "vector",
          "const": "vector"
        }
      ]
    },
    "ddTipoRelacion": {
      "oneOf": [
        {
          "title": "opuesto",
          "const": "opuesto"
        },
        {
          "title": "otro",
          "const": "otro"
        },
        {
          "title": "similar",
          "const": "similar"
        }
      ]
    },
    "ddTipoRol": {
      "oneOf": [
        {
          "title": "Agregación",
          "const": "Agregación"
        },
        {
          "title": "Composición",
          "const": "Composición"
        },
        {
          "title": "Ordinaria",
          "const": "Ordinaria"
        }
      ]
    },
    "ddUnidadMedida": {
      "oneOf": [
        {
          "title": "Ángulo",
          "const": "Ángulo"
        },
        {
          "title": "Área",
          "const": "Área"
        },
        {
          "title": "Escala",
          "const": "Escala"
        },
        {
          "title": "Longitud",
          "const": "Longitud"
        },
        {
          "title": "No Aplica",
          "const": "No Aplica"
        },
        {
          "title": "Tiempo",
          "const": "Tiempo"
        },
        {
          "title": "Velocidad",
          "const": "Velocidad"
        },
        {
          "title": "Volumen",
          "const": "Volumen"
        }
      ]
    },
    "ddValorDominio": {
      "type": "object",
      "title": "Valor de dominio",
      "description": "Valor de dominio del atributo",
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "type": "string",
          "title": "Código de dominio",
          "description": "Código de dominio"
        },
        "etiqueta": {
          "type": "string",
          "title": "Etiqueta",
          "description": "Etiqueta"
        },
        "definicion": {
          "type": "string",
          "title": "Definición del valor de dominio",
          "description": "Definición del valor de dominio",
          "maxLength": 330
        }
      },
      "required": [
        "codigo",
        "etiqueta",
        "definicion"
      ]
    },
    "ddVisibilidad": {
      "oneOf": [
        {
          "title": "Pública",
          "const": "Pública"
        },
        {
          "title": "Clasificada",
          "const": "Pública Clasificada"
        },
        {
          "title": "Reservada",
          "const": "Pública Reservada"
        }
      ]
    }
  },
  "required": [
    "id",
    "identificadorRecursoUniforme",
    "nombre",
    "definicion",
    "campoAplicacion",
    "esDocumentacionPublica",
    "tematica"
  ]
}