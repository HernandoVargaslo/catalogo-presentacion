    "nombre": {
      "type": "string",
      "title": "Nombre del Objeto",
      "description": "Nombre del Objeto",
      "readOnly": true
    },
    "nombreAlternativo": {
      "type": "string",
      "title": "Nombre Alternativo",
      "description": "Nombre Alternativo",
      "readOnly": true
    },
    "nombreEspecificacion": {
      "type": "string",
      "title": "Nombre de la especificación",
      "description": "Nombre de la especificación"
    },
    "version": {
      "type": ["string", "null"],
      "title": "Versión Especificación",
      "description": "Versión Especificación"
    },
    "fechaVersionET": {
      "type": "string",
      "title": "Fecha de Versión",
      "description": "Fecha de Versión",
      "format": "date"
    },
    "autor": {
      "type": "string",
      "title": "Autor",
      "description": "Autor"
    },
    "controlcambio": {
      "type": ["string", "null"],
      "title": "Cambio efectuado",
      "description": "Cambio efectuado"
    },
    "entidad": {
      "type": "string",
      "title": "Entidad",
      "description": "Entidad",
      "readOnly": true
    },
    "dependencia": {
      "type": "string",
      "title": "Dependencia",
      "description": "Dependencia"
    },
    "direccion": {
      "type": "string",
      "title": "Dirección",
      "description": "Dirección",
      "readOnly": true
    },
    "email": {
      "type": ["string", "null"],
      "title": "Correo electrónico",
      "description": "Correo electrónico",
      "format": "email",
      "readOnly": true
    },
    "telefono": {
      "type": ["string", "null"],
      "title": "Teléfonos de Contacto",
      "description": "Teléfonos de Contacto",
      "readOnly": true
    },
    "idioma": {
      "type": "string",
      "title": "Idioma",
      "description": "Idioma",
      "$ref": "#/$defs/etIdioma"
    },
    "restriccionUso": {
      "type": "string",
      "title": "Restricción de Uso",
      "description": "Restricción de Uso",
      "$ref": "#/$defs/etRestriccionUso"
    },
    "terminosDefiniciones": {
      "type": "array",
      "title": "Términos y definiciones",
      "description": "Términos y definiciones",
      "items": {
        "$ref": "#/$defs/etTerminosDefiniciones"
      },
      "uniqueItemProperties": [
        "termino"
      ]
    },
    "abreviaturas": {
      "type": "array",
      "title": "Abreviaturas",
      "description": "Abreviaturas",
      "items": {
        "$ref": "#/$defs/etAbreviaturas"
      },
      "uniqueItemProperties": [
        "abreviatura"
      ]
    },
    "vision": {
      "type": "string",
      "title": "Descripción Informal / Visión general de la Especificación Técnica",
      "description": "Descripción Informal / Visión general de la Especificación Técnica"
